VERSION "Observation only - unverified Leaf IC longitudinal candidates"

NS_ :
    CM_
    BA_DEF_
    BA_
    VAL_

BS_:

BU_: UNKNOWN OBSERVER

BO_ 688 LONG_REQUEST_CANDIDATE: 8 UNKNOWN
 SG_ RAW_HIGH8 : 8|8@1+ (1,0) [0|255] "raw" OBSERVER
 SG_ RAW_LOW4 : 16|4@1+ (1,0) [0|15] "raw" OBSERVER
 SG_ RAW_FRACTION2 : 58|2@1+ (1,0) [0|3] "raw" OBSERVER
 SG_ CARRY_HIGH4_CANDIDATE : 20|4@1+ (1,0) [0|15] "raw" OBSERVER
 SG_ ALT_HIGH4_CANDIDATE : 12|4@1+ (1,0) [0|15] "raw" OBSERVER
 SG_ ALT_LOW8_FROM_INVERSE : 0|8@1+ (-1,255) [0|255] "raw" OBSERVER
 SG_ LONG_ACTIVE_CANDIDATE : 38|1@1+ (1,0) [0|1] "" OBSERVER
 SG_ OWNERSHIP_RAW : 24|8@1+ (1,0) [0|255] "raw" OBSERVER
 SG_ COUNTER4 : 52|4@1+ (1,0) [0|15] "" OBSERVER

BO_ 451 BRAKE_REQUEST_CANDIDATE: 8 UNKNOWN
 SG_ PRESSURE_RAW10_CANDIDATE : 5|10@0+ (1,0) [0|1023] "raw" OBSERVER
 SG_ BRAKE_ACTIVE_CANDIDATE : 47|1@1+ (1,0) [0|1] "" OBSERVER
 SG_ MODE_BIT2_UNKNOWN : 42|1@1+ (1,0) [0|1] "" OBSERVER
 SG_ COUNTER2 : 40|2@1+ (1,0) [0|3] "" OBSERVER
